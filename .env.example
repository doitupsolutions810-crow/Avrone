# --- Provider preset: openclaw (default) | xai | openai | openrouter | ollama | custom ---
AVRONE_PROVIDER=openclaw

# --- Model backend overrides (optional; win over the preset) ---
AVRONE_LLM_BASE_URL=http://127.0.0.1:18789/v1
AVRONE_LLM_API_KEY=your-openclaw-gateway-token
AVRONE_LLM_MODEL=openclaw
# Or use xAI Grok directly:
# AVRONE_LLM_BASE_URL=https://api.x.ai/v1
# AVRONE_LLM_API_KEY=xai-...
# AVRONE_LLM_MODEL=grok-4
# Optional stronger model just for the Lead agent:
# AVRONE_LEAD_MODEL=
# Run with no model at all (demo/tests):
# AVRONE_LLM_MODE=mock

# --- Orchestration ---
AVRONE_DEEP_SQUAD_SIZE=4      # Deep Analysis reviewers (max 6)
AVRONE_MAX_PARALLEL=6         # concurrent model calls
AVRONE_LLM_RETRIES=3
AVRONE_LLM_BACKOFF=1.5
AVRONE_SQUAD_SIZE=4
AVRONE_MAX_STEPS=6
AVRONE_MAX_SPAWN_DEPTH=2

# --- Environment ---
AVRONE_RUNNER=auto            # auto | docker | local
AVRONE_DOCKER_IMAGE=python:3.12-slim
AVRONE_ALLOW_NETWORK=true
AVRONE_AGENTS_CAN_SHELL=true
AVRONE_WORKSPACE=./workspace
AVRONE_DATA_DIR=./data

# --- Admin terminal (leave empty to disable) ---
AVRONE_ADMIN_TOKEN=
AVRONE_HOST=127.0.0.1
AVRONE_PORT=8710

# --- Extensions ---
AVRONE_PLUGINS_DIR=./plugins
AVRONE_MCP_CONFIG=./mcp.json
# AVRONE_SEARCH_PROVIDER=auto   # duckduckgo | brave | tavily
# BRAVE_API_KEY=
# TAVILY_API_KEY=

# --- Fleet (v0.5): link AVRONE servers so agents spawn agents on remote nodes ---
# AVRONE_FLEET_TOKEN=long-random-shared-secret   # required; same on every node
# AVRONE_NODE_ID=edge-1                          # stable, unique per node
# AVRONE_PUBLIC_URL=https://edge-1.example:8000  # how others reach this node
# AVRONE_FLEET_PARENT=https://router.example:8000
# AVRONE_FLEET_MAX_HOPS=3
# AVRONE_FLEET_ALLOW=router,edge-1,edge-2        # optional allowlist of node ids
# AVRONE_FLEET_HEARTBEAT=15

# --- Gateway (v0.7): fallback providers, tried in order after the primary ---
# AVRONE_LLM_FALLBACKS=openrouter:x-ai/grok-4,ollama:llama3.1
# AVRONE_BREAKER_THRESHOLD=3
# AVRONE_BREAKER_COOLDOWN=30

# --- Agent kit (v0.8) ---
# AVRONE_SELF_CHANGES=allow   # allow | log | deny (env_install / logged shell installs)
# AVRONE_SKILLS_DIR=./skills

# --- Self-evolution (v0.9) ---
# AVRONE_SELF_EVOLVE=allow        # allow | deny
# AVRONE_REPO_DIR=.               # repo root AVRONE may propose edits to
# AVRONE_EVOLVE_TEST_CMD=python -m pytest -q

# --- Reconnaissance (v0.10) ---
# AVRONE_RECON=allow              # allow | deny
# AVRONE_RECON_ALLOWLIST=        # comma hosts/suffixes to restrict recon to; empty = any


# --- API access controls (v0.14) ---
# auto: loopback clients allowed; remote clients require X-API-Token
# always: token required even through reverse proxies and on loopback
# off: disables API auth checks; not recommended outside isolated development
AVRONE_API_AUTH=auto
AVRONE_API_TOKEN=

# --- Operator-only host service gateway (never an agent shell) ---
# Enable only after installing a root-owned sudoers policy for exact systemctl commands
AVRONE_ROOT_GATEWAY_ENABLED=false
AVRONE_ROOT_GATEWAY_TOKEN=
AVRONE_ROOT_GATEWAY_OPERATIONS=service_status,service_restart
AVRONE_ROOT_GATEWAY_SERVICES=avrone.service

# Keep the host runner unprivileged; this break-glass override permits host-root agent shell
AVRONE_ALLOW_ROOT_LOCAL=false

# Fleet peers: HTTPS required except loopback unless explicit opt-in for legacy private HTTP
AVRONE_FLEET_ALLOW_INSECURE_HTTP=false

# Self-evolution budgets: 15-minute proposal cap, 1 hour/day and 12 attempts/day by default
AVRONE_EVOLVE_MAX_SECONDS=900
AVRONE_EVOLVE_MAX_DAILY_SECONDS=3600
AVRONE_EVOLVE_MAX_DAILY_PROPOSALS=12

# --- Remote API authentication ---
# auto allows loopback clients; remote clients need X-API-Token. Use always behind reverse proxies.
AVRONE_API_AUTH=auto
AVRONE_API_TOKEN=

# --- Restricted operator host-service gateway (not an agent shell) ---
AVRONE_ROOT_GATEWAY_ENABLED=false
AVRONE_ROOT_GATEWAY_TOKEN=
AVRONE_ROOT_GATEWAY_OPERATIONS=service_status,service_restart
AVRONE_ROOT_GATEWAY_SERVICES=avrone.service
# Keep the host runner unprivileged. This override permits agent shell as host root.
AVRONE_ALLOW_ROOT_LOCAL=false

# HTTPS is required for non-loopback fleet peers unless you explicitly opt into legacy HTTP.
AVRONE_FLEET_ALLOW_INSECURE_HTTP=false

# Self-evolution proposal and daily budgets.
AVRONE_EVOLVE_MAX_SECONDS=900
AVRONE_EVOLVE_MAX_DAILY_SECONDS=3600
AVRONE_EVOLVE_MAX_DAILY_PROPOSALS=12

# Exact authorized private agent HTTP targets (comma-separated hostnames or IPs only).
# Empty = block private IPs; wildcards/CIDRs are ignored; loopback/link-local/metadata are never allowed.
AVRONE_HTTP_PRIVATE_ALLOWLIST=

# Agent-owned Docker sandbox controls (used by DockerRunner and docker_run).
AVRONE_DOCKER_MEMORY_LIMIT=2g
AVRONE_DOCKER_CPU_LIMIT=2
AVRONE_DOCKER_PIDS_LIMIT=512
# Empty list permits any syntactically valid Docker image; production should list exact approved images.
AVRONE_DOCKER_IMAGE_ALLOWLIST=
# Applies to both the primary agent container and docker_run images when enabled.
AVRONE_DOCKER_REQUIRE_DIGEST=false
