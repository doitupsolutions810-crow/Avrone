# Local development defaults for the Base44 sandbox. Committed placeholders only.
# /run/base44/app.env (platform-managed secrets) is loaded AFTER this file, so any
# value supplied in the Base44 dashboard overrides what is set here.

# --- Model backend: local Ollama, OpenAI-compatible, no credentials needed ---
AVRONE_PROVIDER=ollama
AVRONE_LLM_BASE_URL=http://ollama:11434/v1
AVRONE_LLM_MODEL=qwen2.5:3b
AVRONE_LLM_MODE=live
AVRONE_LLM_TIMEOUT=300

# --- Environment: agents run in a local sandbox inside this container ---
# (no Docker socket is mounted, so the docker runner is not available)
AVRONE_RUNNER=local
AVRONE_WORKSPACE=/app/workspace
AVRONE_DATA_DIR=/app/data
AVRONE_ALLOW_NETWORK=true
AVRONE_AGENTS_CAN_SHELL=true

# --- Extensions shipped in the repo ---
AVRONE_PLUGINS_DIR=/app/plugins
AVRONE_MCP_CONFIG=/app/mcp.json

# --- Dev-only admin token so the Terminal / fleet tabs are usable in the preview.
# Replace it (or clear it to disable admin access) before exposing this anywhere real.
AVRONE_ADMIN_TOKEN=dev-admin
