# Local Ollama + Docker per-agent sandbox profile.
# Copy this file to local-ollama-sandbox.env and edit only the model/limits you need.
AVRONE_PROVIDER=ollama
AVRONE_LLM_BASE_URL=http://127.0.0.1:11434/v1
AVRONE_LLM_MODEL=qwen2.5:3b
AVRONE_LEAD_MODEL=qwen2.5:3b
AVRONE_LLM_MODE=live
AVRONE_LLM_TIMEOUT=180
AVRONE_LLM_RETRIES=2

# The AVRONE server runs on the host; agent commands run in sibling Docker containers.
AVRONE_RUNNER=docker
AVRONE_DOCKER_IMAGE=python:3.12-slim
AVRONE_ALLOW_NETWORK=false
AVRONE_AGENT_FS=1
AVRONE_AGENT_DOCKER_ISOLATE=0
AVRONE_AGENT_CONTAINER=persistent
AVRONE_AGENT_MEM_MB=512
AVRONE_AGENT_CPUS=1.0
AVRONE_AGENT_IDLE_SECS=600
AVRONE_AGENT_FS_QUOTA_MB=128
AVRONE_AGENT_FS_MAX_FILE_MB=16
AVRONE_AGENTS_CAN_SHELL=true

# Small local-model concurrency defaults; raise only after benchmarking your host.
AVRONE_SQUAD_SIZE=2
AVRONE_MAX_PARALLEL=2
AVRONE_MAX_STEPS=8
AVRONE_MAX_SPAWN_DEPTH=1
AVRONE_AGENT_TIMEOUT=900
AVRONE_GOVERNOR=true

# Bind the control API to loopback. Empty disables the admin terminal.
AVRONE_HOST=127.0.0.1
AVRONE_PORT=8710
AVRONE_ADMIN_TOKEN=
