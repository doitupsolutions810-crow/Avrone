# Sandbox defaults for the Base44 dev environment (docker-compose.base44.yml).
# Listed FIRST in the service's env_file, so any value delivered from the Base44
# dashboard (/run/base44/app.env) overrides the placeholder here.

# Model backend: AVRONE's built-in demo mode, so the preview is usable without
# credentials. For real answers, set AVRONE_LLM_MODE=live plus a provider and its
# key in the dashboard (AVRONE_PROVIDER=xai + XAI_API_KEY, or openai / openrouter).
AVRONE_LLM_MODE=mock
AVRONE_PROVIDER=ollama
AVRONE_LLM_MODEL=qwen2.5:3b

# Agents run as local subprocesses inside the server container (the sandbox has
# no Docker socket), confined to the workspace directory by the local runner.
AVRONE_RUNNER=local
AVRONE_ALLOW_NETWORK=false
AVRONE_AGENTS_CAN_SHELL=true

# The admin terminal stays off (AVRONE_ADMIN_TOKEN unset) because the preview URL
# is public. Set AVRONE_ADMIN_TOKEN in the dashboard to enable it.
